# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=intersul_user
DB_PASSWORD=intersul_password
DB_DATABASE=intersul
DB_ROOT_PASSWORD=rootpassword

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# Application Configuration
NODE_ENV=development
PORT=3000

# Redis Configuration
# Option 1: Use REDIS_URL (recommended for cloud providers like Railway)
# REDIS_URL=redis://:password@host:port

# Option 2: Use individual components
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=optional_password

# CORS
FRONTEND_URL=http://localhost:5173

# Cloudflare R2 Storage Configuration
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
ENDPOINT_FOR_S3_CLIENTS=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-account-id.r2.dev
R2_TOKEN_API=your-r2-token-api
